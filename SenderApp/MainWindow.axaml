<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="640"
        x:Class="SenderApp.MainWindow"
        Title="Sender — Agent de Mesagerie"
        Width="440" Height="640" MinWidth="380" MinHeight="480"
        Background="#F3F4F6">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D6DEE5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0D8A8C"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0A6F70"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#9FC9C9"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,4,0,18">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Ellipse Width="10" Height="10" Fill="#0D8A8C" VerticalAlignment="Center"/>
        <TextBlock Text="SENDER" FontSize="22" FontWeight="Bold" Foreground="#16202B"/>
      </StackPanel>
      <TextBlock Text="Publisher · trimite mesaje pe un topic către Broker (127.0.0.1:5000)"
                 Foreground="#54626F" FontSize="12.5"/>
    </StackPanel>

    <!-- Form card -->
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,14"
            BorderBrush="#D6DEE5" BorderThickness="1">
      <StackPanel Spacing="10">
        <StackPanel Spacing="4">
          <TextBlock Text="TOPIC" FontSize="10.5" FontWeight="SemiBold" Foreground="#54626F"/>
          <TextBox Name="TopicBox" Watermark="ex: Curs" Text="Curs"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="MESAJ" FontSize="10.5" FontWeight="SemiBold" Foreground="#54626F"/>
          <TextBox Name="MessageBox" Watermark="scrie mesajul aici..." AcceptsReturn="True"
                    TextWrapping="Wrap" Height="80"/>
        </StackPanel>
        <Button Name="SendButton" Classes="primary" Content="Trimite mesaj" HorizontalAlignment="Stretch"
                Click="OnSendClick"/>
        <TextBlock Name="StatusText" FontSize="12" Text=" " />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="2" Text="ISTORIC TRIMISE" FontSize="10.5" FontWeight="SemiBold"
               Foreground="#54626F" Margin="2,0,0,8"/>

    <!-- History -->
    <ScrollViewer Grid.Row="3">
      <ItemsControl Name="HistoryList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,8"
                    BorderBrush="#D6DEE5" BorderThickness="1">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Background="#0D8A8C" CornerRadius="6" Padding="7,3" Margin="0,0,10,0" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Topic}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Payload}" TextWrapping="Wrap" FontSize="13" Foreground="#16202B"/>
                  <TextBlock Text="{Binding Time}" FontSize="10.5" Foreground="#9AA7B2"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatusIcon}" FontSize="14" VerticalAlignment="Top"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>
</Window>
